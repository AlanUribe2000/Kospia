<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de arranque Kospia (segundo 0): fondo violeta de marca con la flor
     centrada, coherente con el icono de la app que el usuario acaba de tocar.
     El video de intro (sobre lila claro) aparece inmediatamente despues. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kospiaBackground" />

    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_flower" />
    </item>
</layer-list>
